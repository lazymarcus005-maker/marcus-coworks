{
  "name": "@studio/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "smoke": "electron-vite build && STUDIO_SMOKE=1 electron .",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder --mac --arm64",
    "dist:dir": "npm run build && electron-builder --mac dir --arm64"
  },
  "dependencies": {
    "@studio/persistence": "*",
    "@studio/project-manager": "*",
    "@studio/shared": "*",
    "solid-js": "^1.9.9",
    "@studio/opencode-adapter": "*",
    "@studio/task-manager": "*",
    "node-pty": "^1.1.0",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@studio/worktree-manager": "*",
    "@studio/lock-manager": "*",
    "@studio/policy-engine": "*",
    "@studio/failure-classifier": "*"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-vite": "^4.0.0",
    "vite": "^7.1.9",
    "vite-plugin-solid": "^2.11.7",
    "electron-builder": "^26.0.12"
  },
  "description": "OpenCode Agent Studio \u2014 macOS multi-project coding-agent workspace",
  "author": {
    "name": "lazymarcus005-maker"
  },
  "productName": "OpenCode Agent Studio"
